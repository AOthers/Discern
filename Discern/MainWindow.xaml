<Window x:Class="Discern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discern"
        Icon="Discern.ico"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0}"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部工具条 ===== -->
        <Border Grid.Row="0" Background="{StaticResource Bg1}" Padding="16,12"
                BorderBrush="#222B32" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Discern" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Background="#20272E" CornerRadius="4" Padding="8,3" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtElevation" Text="检测中…" FontSize="11"
                                   Foreground="{StaticResource Fg1}"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="TxtStatus" Text="正在扫描光驱…"
                           Foreground="{StaticResource Fg1}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox x:Name="ChkAuto" Content="插入后自动启动" Foreground="{StaticResource Fg1}"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              Checked="ChkAuto_Changed" Unchecked="ChkAuto_Changed"/>
                    <CheckBox x:Name="ChkAutoStart" Content="开机常驻" Foreground="{StaticResource Fg1}"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              ToolTip="登录 Windows 后自动在托盘运行，插盘即识别"
                              Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                    <Button x:Name="BtnRescan" Content="重新扫描" Click="BtnRescan_Click"/>
                    <Button x:Name="BtnOpenConfig" Content="打开配置目录" Click="BtnOpenConfig_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 光驱列表 -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" CornerRadius="8"
                    BorderBrush="#222B32" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="光驱" FontSize="12"
                               Foreground="{StaticResource Fg1}" Margin="14,12,14,6"/>
                    <ListBox x:Name="DriveList" Background="Transparent" BorderThickness="0"
                             Margin="6,0,6,8" SelectionChanged="DriveList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding Accent}"
                                            CornerRadius="2" Margin="0,2,10,2"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Headline}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subline}" FontSize="11"
                                                   Foreground="{StaticResource Fg1}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,9"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg0}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="6" Margin="0,1"
                                                    Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1F272E"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#24313B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 详情 -->
            <Border Grid.Column="2" Background="{StaticResource Bg1}" CornerRadius="8"
                    BorderBrush="#222B32" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="TxtKind" Text="—" FontSize="12"
                                   Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtTitle" Text="选择左侧光驱查看识别结果" FontSize="24"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <UniformGrid x:Name="PropsGrid" Columns="2" Margin="0,0,0,16"/>

                        <TextBlock Text="识别依据" FontSize="12" Foreground="{StaticResource Fg1}"
                                   Margin="0,0,0,6"/>
                        <Border Background="{StaticResource Bg2}" CornerRadius="6" Padding="12,8">
                            <StackPanel x:Name="EvidencePanel"/>
                        </Border>

                        <TextBlock Text="根目录" FontSize="12" Foreground="{StaticResource Fg1}"
                                   Margin="0,16,0,6"/>
                        <Border Background="{StaticResource Bg2}" CornerRadius="6" Padding="12,8">
                            <TextBlock x:Name="TxtRoot" Text="—" FontFamily="Consolas, Cascadia Mono"
                                       FontSize="12" Foreground="{StaticResource Fg1}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="BtnLaunch" Content="立即启动" Click="BtnLaunch_Click"
                                    Background="#1D4E6E" BorderBrush="#2A6E96"/>
                            <Button x:Name="BtnOpenDrive" Content="打开光盘" Click="BtnOpenDrive_Click"/>
                            <Button x:Name="BtnReprobe" Content="重新识别" Click="BtnReprobe_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== 日志 ===== -->
        <Border Grid.Row="2" Background="{StaticResource Bg1}" Padding="14,10"
                BorderBrush="#222B32" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="运行日志" FontSize="11"
                           Foreground="{StaticResource Fg1}" Margin="0,0,0,4"/>
                <TextBox x:Name="LogBox" Height="110" IsReadOnly="True" BorderThickness="0"
                         Background="{StaticResource Bg0}" Foreground="{StaticResource Fg1}"
                         FontFamily="Consolas, Cascadia Mono" FontSize="11"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Padding="8,6" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
